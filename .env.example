# Postgres
POSTGRES_DB=zamtrust
POSTGRES_USER=zamtrust
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# Application secrets — generate with: openssl rand -base64 64 | tr -d '\n'
ZAMTRUST_JWT_SECRET=change-me-to-a-strong-random-secret

# Public URL of your deployed app
ZAMTRUST_BASE_URL=https://zamtrust.example.com
