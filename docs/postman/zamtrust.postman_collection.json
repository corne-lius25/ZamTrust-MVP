{
  "info": {
    "name": "ZamTrust API",
    "_postman_id": "c9d3f3e8-3f8b-4a3a-9a2a-zamtrust001",
    "description": "ZamTrust — Secure Digital Document Signing and Verification Platform. Run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"{{fullName}}\",\n  \"organization\": \"{{organization}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.token) pm.environment.set('token', body.token);",
              "pm.test('Token present', () => pm.expect(body.token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. Upload Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.id) pm.environment.set('docId', body.id);",
              "if (body.verificationId) pm.environment.set('verificationId', body.verificationId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample.txt"
            },
            {
              "key": "title",
              "value": "Postman Test Document",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents"
          ]
        }
      }
    },
    {
      "name": "4. Sign Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Algorithm RSA', () => pm.expect(body.algorithm).to.eql('SHA256withRSA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/sign",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}",
            "sign"
          ]
        }
      }
    },
    {
      "name": "5. Verify Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Integrity valid', () => pm.expect(body.integrityValid).to.be.true);",
              "pm.test('Signature valid', () => pm.expect(body.signatureValid).to.be.true);",
              "pm.test('Message VALID', () => pm.expect(body.message).to.eql('VALID'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/verifications/{{verificationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verifications",
            "{{verificationId}}"
          ]
        }
      }
    },
    {
      "name": "6. QR Code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/public/qr/{{verificationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "qr",
            "{{verificationId}}"
          ]
        }
      }
    },
    {
      "name": "7. Audit Trail for Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/audit/resource/{{verificationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "audit",
            "resource",
            "{{verificationId}}"
          ]
        }
      }
    }
  ]
}